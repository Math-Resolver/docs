{
  "info": {
    "name": "Equation Solver API",
    "description": "Collection oficial da API para Entrega 4 + Checkpoint 2 (Bloco 4). Inclui endpoints, métodos HTTP, parâmetros, exemplos de request/response e códigos de status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accessToken",
      "value": "dev-user:juliana"
    }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"user@gmail.com\",\n  \"deviceFingerprint\": \"iphone-15,5/uuid\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "register"]
        },
        "description": "Inicia o processo de cadastro e retorna challenge WebAuthn.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"challenge\": \"hashASAHASD...\",\n  \"relyingParty\": {\n    \"id\": \"seuapp.com\",\n    \"name\": \"Seu App\"\n  },\n  \"user\": {\n    \"id\": \"uuid-123\",\n    \"username\": \"user@gmail.com\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Auth - Register Finish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credential\": \"hashASAHASD...\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/register/finish",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "register", "finish"]
        },
        "description": "Finaliza cadastro WebAuthn.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "login"]
        },
        "description": "Inicia login e retorna challenge.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"challenge\": \"hashASJANS...\",\n  \"relyingParty\": {\n    \"id\": \"seuapp.com\",\n    \"name\": \"Seu App\"\n  },\n  \"user\": {\n    \"id\": \"uuid-123\",\n    \"username\": \"user@gmail.com\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Auth - Login Finish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"credential\": \"hashASAHASD...\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/login/finish",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "login", "finish"]
        },
        "description": "Finaliza login.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"access_token\": \"access-token\",\n  \"refresh_token\": \"refresh-token\"\n}"
        }
      ]
    },
    {
      "name": "Auth - Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"refresh-token\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/refresh-token",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "refresh-token"]
        },
        "description": "Renova tokens de autenticação.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"access_token\": \"new-access-token\",\n  \"refresh_token\": \"new-refresh-token\"\n}"
        }
      ]
    },
    {
      "name": "Conversation - Available Topics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/topics/available",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "topics", "available"]
        },
        "description": "Retorna os tópicos disponíveis para explicação de IA.\nStatus esperados: 200, 401"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"topics\": [\n    \"Logarithm\",\n    \"Derivative\"\n  ]\n}"
        },
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"detail\": \"Not authenticated\"\n}"
        }
      ]
    },
    {
      "name": "Conversation - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"Logarithm\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/conversation",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "conversation"]
        },
        "description": "Gera explicação de tópico via IA com suporte a cache.\nStatus esperados: 200, 401, 502"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"is_operation_successful\": true,\n  \"message\": \"A logarithm tells which exponent produces a value.\",\n  \"example\": \"log2(8)=3\"\n}"
        },
        {
          "name": "502 Bad Gateway",
          "status": "Bad Gateway",
          "code": 502,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"is_operation_successful\": false,\n  \"message\": \"AI provider unavailable\",\n  \"example\": null\n}"
        }
      ]
    },
    {
      "name": "Equation - Solve",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equation\": \"x^2 - 5x + 6 = 0\",\n  \"showSteps\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/equation/solve",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "equation", "solve"]
        },
        "description": "Resolve equações suportadas e retorna resultado detalhado.\nStatus esperados: 200, 400, 499, 502"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"result\": \"x1 = 3, x2 = 2\",\n  \"steps\": [\n    {\n      \"rule\": \"factorization\",\n      \"before\": \"x^2 - 5x + 6 = 0\",\n      \"after\": \"(x - 2)(x - 3) = 0\"\n    }\n  ],\n  \"graph\": null\n}"
        },
        {
          "name": "400 Bad Request",
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"detail\": \"Invalid equation syntax\"\n}"
        },
        {
          "name": "502 Bad Gateway",
          "status": "Bad Gateway",
          "code": 502,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"detail\": \"Tipo de equação não suportada para resolução\"\n}"
        }
      ]
    },
    {
      "name": "Equation - History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/equation/history",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "equation", "history"]
        },
        "description": "Retorna histórico de equações do usuário autenticado.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "[\n  {\n    \"equation\": \"2*x + 5 = 15\",\n    \"result\": \"x = 5\",\n    \"steps\": [\n      {\n        \"rule\": \"subtract 5 from both sides\",\n        \"before\": \"2*x + 5 = 15\",\n        \"after\": \"2*x = 10\"\n      }\n    ]\n  }\n]"
        }
      ]
    },
    {
      "name": "System - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "health"]
        },
        "description": "Endpoint de disponibilidade do serviço.\nStatus esperados: 200"
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    }
  ]
}
